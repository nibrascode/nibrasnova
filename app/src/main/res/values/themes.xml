<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NibrasNova" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.NibrasNova.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0F1D</item>
