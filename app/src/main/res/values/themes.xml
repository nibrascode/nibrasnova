<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="nova_deep_navy">#0A0F1D</color>

    <style name="Theme.NibrasNova" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.NibrasNova.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nova_deep_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.NibrasNova</item>
    </style>
</resources>
