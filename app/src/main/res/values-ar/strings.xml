    <string name="set_language">اللغة</string>
    <string name="set_language_info">اختر لغة التطبيق: الأذربيجانية أو التركية أو الإنجليزية أو الروسية أو العربية. يفتح إعدادات لغة أندرويد لهذا التطبيق (أندرويد 13 فأحدث).</string>
    <string name="set_language_unsupported">في هذا الإصدار من أندرويد، غيّر اللغة من إعدادات النظام.</string>
    <string name="set_search">محرك البحث</string>
    <string name="set_search_info">الموقع المستخدم عند كتابة كلمات بدل العنوان (DuckDuckGo أو Google أو Bing أو Brave أو Startpage أو محرك مخصص).</string>
    <string name="set_theme">المظهر والخلفية</string>
    <string name="set_theme_info">مظهر داكن أو فاتح أو حسب النظام، ولون التمييز وخلفية الصفحة الرئيسية.</string>
    <string name="set_homepage">عنوان الصفحة الرئيسية</string>
    <string name="set_homepage_info">الصفحة التي يفتحها زر الرئيسية. اترك nova://home لاستخدام صفحة نبراس المدمجة.</string>
    <string name="set_home_shortcuts">الروابط السريعة</string>
    <string name="set_home_shortcuts_info">يعرض مواقعك المحفوظة كمربعات في الصفحة الرئيسية. يبقى nibrascode.com دائمًا.</string>
    <string name="set_home_recent">تمت زيارتها مؤخرًا</string>
    <string name="set_home_recent_info">يعرض آخر زياراتك (غير الخفية) في الصفحة الرئيسية.</string>
    <string name="set_restore_tabs">استعادة علامات التبويب</string>
    <string name="set_restore_tabs_info">يعيد فتح علاماتك العادية عند تشغيل التطبيق. لا تُستعاد العلامات الخفية أبدًا.</string>
    <string name="set_desktop_mode">مواقع سطح المكتب</string>
    <string name="set_desktop_mode_info">يفتح العلامات الجديدة بنسخة سطح المكتب من المواقع.</string>
    <string name="set_user_agent">هوية المتصفح</string>
    <string name="set_user_agent_info">الجهاز الذي يعرّف المتصفح نفسه به للمواقع (user-agent). مفيد عندما يعمل موقع على نظام معيّن فقط.</string>
    <string name="set_data_saver">توفير البيانات</string>
    <string name="set_data_saver_info">على الاتصالات المحدودة، يحظر الصور الثقيلة ويوقف التشغيل التلقائي للفيديو.</string>
    <string name="set_hibernation">توفير الذاكرة</string>
    <string name="set_hibernation_info">يُسبت علامات التبويب غير المستخدمة في الخلفية (أكثر من 4) لتوفير الذاكرة، وتُعاد تحميلها عند الرجوع إليها.</string>
    <string name="set_bottom_bar">شريط العنوان في الأسفل</string>
    <string name="set_bottom_bar_info">ينقل شريط العنوان إلى الأسفل لتصل إليه بيد واحدة.</string>
    <string name="set_tab_strip">شريط علامات التبويب</string>
    <string name="set_tab_strip_info">يعرض علامات التبويب في صف بالأعلى كما في الحاسوب للتبديل بلمسة واحدة.</string>
    <string name="set_bg_audio">الصوت في الخلفية</string>
    <string name="set_bg_audio_info">يستمر تشغيل الصوت والبودكاست عند تبديل العلامات أو إطفاء الشاشة.</string>
    <string name="set_external_links">روابط التطبيقات الأخرى</string>
    <string name="set_external_links_info">ماذا يحدث عندما يريد رابط فتح تطبيق آخر (مثل الخرائط أو المتجر).</string>
    <string name="link_ask">اسأل في كل مرة</string>
    <string name="link_always">افتح التطبيق دائمًا</string>
    <string name="link_stay">البقاء في نبراس نوفا</string>
    <string name="set_privacy_center">مركز الخصوصية</string>
    <string name="set_privacy_center_info">حظر الإعلانات والمتتبعات، HTTPS فقط، الحماية من البصمة، DNS آمن (DoH)، الوكيل، ملفات تعريف الارتباط، القفل الحيوي والنسخ الاحتياطي المشفّر.</string>
    <string name="set_lan_sync">النقل عبر Wi-Fi</string>
    <string name="set_lan_sync_info">أرسل العلامات المفتوحة والإشارات إلى جهاز آخر على نفس شبكة Wi-Fi بمسح رمز QR، دون أي خادم سحابي.</string>
    <string name="set_userscripts">السكربتات والأنماط</string>
    <string name="set_userscripts_info">أضف JavaScript أو CSS خاصًا بك لمواقع محددة مثل الإضافات. للمستخدمين المتقدمين.</string>
    <string name="set_rss">قارئ الأخبار (RSS)</string>
    <string name="set_rss_info">تابع مواقع الأخبار والمدونات بلا إعلانات. تُجلب الخلاصات مباشرة من المواقع التي تضيفها.</string>
